# Copy this file to .env for local configuration.
# "auto": in development the app calls http://<IP of the machine running Expo>:8080/api/v1,
# so it keeps working when the Wi-Fi IP changes. Run the backend on the same machine as Expo.
# Otherwise set a full URL including /api/v1, e.g. http://192.168.1.100:8080/api/v1.
# EXPO_PUBLIC_ values are bundled into the app. Never put secrets here.
EXPO_PUBLIC_API_URL=auto
